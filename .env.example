PORT=5000

NODE_ENV=development

# MongoDB Atlas
MONGO_URI=MONGODB_URI=mongodb+srv://aspiringlifedrive%40gmail.com:Magicalthread786%23@cluster0.ng665uf.mongodb.net/baanknet?appName=Cluster0
CLIENT_URL=http://localhost:5173

# ── Auth ──
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── AI (Groq/OpenAI-compatible) ──
# Used to (1) understand natural-language chat questions, (2) convert them
# into structured filters, and (3) explain results already returned by the
# prediction engine. It never invents college/cutoff data itself, and the
# app still works (with reduced NL understanding) if this is left unset.
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=YOUR_GROQ_API_KEY
AI_MODEL=llama-3.3-70b-versatile

# ── Scanned-PDF OCR fallback ──
PDF_OCR_ENABLED=true
PDF_OCR_MAX_PAGES=25
PDF_PARSE_TIMEOUT_MS=90000

# ── Initial admin seed (used only by scripts/seedAdmin.js) ──
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_this_password
SEED_ADMIN_NAME=Super Admin
